# Base URL for the backend API that receives form submissions
# (demo requests, contact/general inquiries, career applications).
# Leave unset in local development to see a clear "no backend configured" message
# instead of a silently-fake success state. See src/utils/api.ts.
VITE_API_BASE_URL=https://api.hexagen.ca

# Canonical production site URL, used by the SEO component to build
# canonical link tags and Open Graph URLs.
VITE_SITE_URL=https://www.hexagen.ca
